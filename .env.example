GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# FAISS Index HMAC-SHA256 Signing Key (required to sign and verify vector store indexes)
# Generate a secure 64-character hex key using:
# python -c "import secrets; print(secrets.token_hex(32))"
STUDYMATE_INDEX_SIGNING_KEY=your_secret_signing_key_here